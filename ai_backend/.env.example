# ============================================
# CS Assist AI 环境变量配置模板
# ============================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据实际情况修改 .env 文件中的配置值
# 3. .env 文件包含敏感信息，不要提交到版本控制系统
# ============================================

# ============================================
# OpenAI 配置
# ============================================
# OpenAI API 密钥（必需）
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI API 基础 URL（可选，默认为官方地址）
# 可以使用 DashScope 兼容模式：https://dashscope.aliyuncs.com/compatible-mode/v1
# 或其他兼容 OpenAI API 的服务地址
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI 模型名称（可选，默认 gpt-4o-mini）
# 例如：qwen-flash, qwen3-30b, gpt-4o-mini 等
OPENAI_MODEL=qwen-flash

# ============================================
# 其他 OpenAI 服务配置示例（可选，注释掉）
# ============================================
# 如果需要使用其他 OpenAI 兼容服务，可以取消注释并配置：
# OPENAI_API_KEY=your-other-api-key-here
# OPENAI_BASE_URL=https://api.agicto.cn/v1
# OPENAI_MODEL=qwen3-30b-a3b

# 或者使用本地部署的服务：
# OPENAI_API_KEY=your-local-api-key-here
# OPENAI_BASE_URL=http://172.31.198.110:30000/v1
# OPENAI_MODEL=qwen3-30b

# ============================================
# 向量化配置
# ============================================
# 嵌入服务配置
# 嵌入服务提供者：ollama, openai, dashscope, qwen
EMBEDDING_PROVIDER=dashscope

# 嵌入模型名称
# Ollama: nomic-embed-text
# OpenAI: text-embedding-ada-002
# DashScope: text-embedding-v1, text-embedding-v2, text-embedding-v4
EMBEDDING_MODEL=text-embedding-v4

# 嵌入服务地址
# Ollama: http://localhost:11434 或 http://172.31.198.110:11434
# DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI: https://api.openai.com/v1
EMBEDDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1

# 嵌入服务 API 密钥（OpenAI/DashScope 等需要）
# 如果使用 DashScope，可以使用 DASHSCOPE_API_KEY 或 EMBEDDING_API_KEY
EMBEDDING_API_KEY=your-embedding-api-key-here

# 嵌入服务超时时间（秒）
EMBEDDING_TIMEOUT=30

# ============================================
# RAG 配置
# ============================================
# 向量数据库集合名称
RAG_COLLECTION_NAME=customer_service_kb

# 检索结果数量
RAG_N_SEARCH_RESULTS=3

# 相似度阈值（0.0-1.0）
RAG_SIMILARITY_THRESHOLD=0.7

# ============================================
# DashScope/Qwen 嵌入服务配置（可选）
# ============================================
# 如果使用 DashScope 作为嵌入服务，可以单独配置：
# EMBEDDING_PROVIDER=dashscope
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ============================================
# ChromaDB 持久化存储路径
# ============================================
# ChromaDB 数据存储路径（使用 ChromaDB 时）
RAG_DB_PATH=./chroma_db

# ============================================
# 向量维度配置
# ============================================
# 向量维度（仅对支持自定义维度的模型有效，如 DashScope text-embedding-v4）
# 设置为 0 或不设置则使用模型默认维度
# 例如：设置为 2048 可获得 2048 维向量（text-embedding-v4 支持）
EMBEDDING_DIMENSIONS=2048

# ============================================
# 向量数据库配置
# ============================================
# 向量数据库类型：chromadb 或 milvus
VECTOR_DB_PROVIDER=milvus

# ============================================
# Milvus 配置（仅在使用 Milvus 时需要）
# ============================================
# Milvus 服务地址
MILVUS_HOST=your-milvus-host-here

# Milvus 服务端口
MILVUS_PORT=19530

# Milvus 用户名（可选，如果 Milvus 启用了认证）
MILVUS_USER=root

# Milvus 密码（可选）
MILVUS_PASSWORD=your-milvus-password-here

# Milvus 数据库名称（可选，指定使用的数据库）
MILVUS_DATABASE=rag

# 注意：如果使用 Milvus，RAG_COLLECTION_NAME 可以设置为 Milvus 中的集合名称
# RAG_COLLECTION_NAME=kefubuzhishiku1028ban_20251028155535

# ============================================
# 日志配置
# ============================================
# 日志目录
LOG_DIR=./logs

# 日志文件最大大小（字节），默认 10MB
LOG_MAX_BYTES=10485760

# 日志备份文件数量，默认 5 个
LOG_BACKUP_COUNT=5
